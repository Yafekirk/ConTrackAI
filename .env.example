SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# Optional override; project ships certs/cacert.pem and auto-detects it.
# SUPABASE_CURL_CA_BUNDLE=C:\path\to\cacert.pem
SUPABASE_TLS_INSECURE=false

# Renewal reminder emails (90/60/30/14/7/1/0 days before a contract ends; 120 too for auto-renew).
# They run automatically once a day on the first portal request; set to false to rely on a scheduler only.
CONTRACK_AUTO_RENEWAL_REMINDERS=true
# Secret for an external scheduler: POST /api/renewal_reminders.php with header "X-Cron-Key: <secret>".
CONTRACK_CRON_SECRET=

